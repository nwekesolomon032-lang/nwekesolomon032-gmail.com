# GEMINI_API_KEY: Required for Gemini AI API calls (if AI features are enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign administrator session cookies.
# If omitted, a persistent cryptographic secret is auto-generated in data/.session-secret.
SESSION_SECRET=""

# RESEND_API_KEY & RESEND_FROM_EMAIL: Optional Resend email configuration
# for sending client application acceptance/rejection notifications.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="SOLMONIX STUDIO <noreply@yourdomain.com>"

# ENQUIRY_WEBHOOK_URL: Optional webhook endpoint (e.g. Make, Zapier, Slack, Formspree)
# to receive project application & notification events.
ENQUIRY_WEBHOOK_URL=""
